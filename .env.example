# 复制本文件为 .env，填入你自己的 API Key（未填的密钥对应功能会提示配置）
# 获取地址：
# - DeepSeek: https://platform.deepseek.com/api_keys（必填，AI 分析底座）
# - Tavily:   https://app.tavily.com（可选，行业动态/新闻证据链）
# - eBay:     https://developer.ebay.com（可选，商品分析，需开发者审核 + 梯子）
# - 速卖通联盟: https://pub.aliexpress.com（可选，商品分析，注册联盟后开放平台建应用，国内直连）

# ── AI 提供商（多模型支持）────────────────────────────────────────────
# 默认 DeepSeek；可选 gpt / claude / custom（任意 OpenAI 兼容接口，如通义/GLM/Ollama）
AI_PROVIDER=deepseek
# AI 服务地址（公网必须 https；本地模型如 Ollama 需同时设 ALLOW_LOCAL_AI_BASE_URL=1）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# AI Key（统一入口；未填时回退到 DEEPSEEK_API_KEY）
AI_API_KEY=
DEEPSEEK_API_KEY=
# 本地模型放行：=1 时允许 http://localhost 等内网地址（仅本地开发用）
ALLOW_LOCAL_AI_BASE_URL=0

# ── 搜索提供商（行业动态/宏观背景/竞争格局/客户线索）────────────────────
SEARCH_PROVIDER=tavily        # tavily（推荐·默认）/ serper / custom
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=

# ── 电商平台凭证（可选）────────────────────────────────────────────────
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# ── UN Comtrade 贸易数据源（可切换）────────────────────────────────────
# mode=preview：免费，无需 key，有 500 条硬截断、部分国家申报数据质量较低
# mode=formal：需注册 subscription key（https://comtradeplus.un.org），数据质量高，推荐
UN_COMTRADE_MODE=preview
UN_COMTRADE_KEY=

# ── 管理员（保护"保存设置"接口）────────────────────────────────────────
# 未配置时每次启动生成随机密码并打印到服务日志（重启失效）；建议固定一个
ADMIN_PASSWORD=

# ── 安全/限流（可选调优）──────────────────────────────────────────────
# Host 白名单（逗号分隔；LAN 演示时把自己的 IP/域名加进来）
ALLOWED_HOSTS=127.0.0.1,localhost
# 匿名请求限流（次/小时，消耗 token 的接口；管理员豁免）
ANON_RATE_LIMIT=30
